# Скопируйте файл в .env и заполните значения.
# Этот файл является только шаблоном и не должен содержать реальные пароли.
# При развертывании через Portainer задайте те же переменные в разделе
# Environment variables и не ведите параллельно отдельный рабочий .env.

# Часовой пояс контейнера
TZ=Europe/Moscow

# Постоянное хранилище на Docker-сервере
STORAGE_ROOT=/opt/invite-mailer-storage

# IMAP Zimbra
IMAP_HOST=mail.domain.ru
IMAP_PORT=993
IMAP_SSL=true
IMAP_USERNAME=service-mailbox@domain.ru
IMAP_PASSWORD=CHANGE_ME
IMAP_FOLDER=INBOX
IMAP_FROM_CONTAINS=1c-robot@
IMAP_LOOKBACK_DAYS=3

# SMTP Zimbra – implicit TLS (SSL) на порту 465
SMTP_HOST=mail.domain.ru
SMTP_PORT=465
SMTP_MODE=ssl
SMTP_USERNAME=training@domain.ru
SMTP_PASSWORD=CHANGE_ME
SMTP_FROM_EMAIL=training@domain.ru
SMTP_FROM_NAME=Система тестирования

# Публикация внутреннего отчета
# Лучше указать внутренний IP Docker-сервера, например 10.0.10.50
REPORT_BIND_IP=0.0.0.0
REPORT_PORT=8080

# Секрет для формирования технического идентификатора из СНИЛС
WORKER_HASH_SECRET=CHANGE_TO_LONG_RANDOM_VALUE

# Прежний список исключений. После первого запуска записи переносятся в
# админку «Сопоставление логинов», затем переменную можно оставить пустой.
LOGIN_OVERRIDES_JSON={}

# PostgreSQL Indigo – пользователь должен иметь права только на чтение
INDIGO_ENABLED=false
INDIGO_DB_HOST=CHANGE_ME
INDIGO_DB_PORT=5436
INDIGO_DB_NAME=CHANGE_ME
INDIGO_DB_USER=CHANGE_ME
INDIGO_DB_PASSWORD=CHANGE_ME
INDIGO_DB_SSLMODE=prefer
INDIGO_DB_CONNECT_TIMEOUT=5

# Административный раздел
ADMIN_USERNAME=admin
ADMIN_DISPLAY_NAME=Администратор
ADMIN_PASSWORD=CHANGE_ME

# Сессия веб-интерфейса. Укажите отдельную случайную строку не короче 32 символов.
SESSION_SECRET=change-this-session-secret-at-least-32-characters
SESSION_MAX_AGE_SECONDS=28800
SESSION_COOKIE_SECURE=false
